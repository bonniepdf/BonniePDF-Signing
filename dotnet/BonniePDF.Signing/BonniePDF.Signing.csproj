<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
    <RootNamespace>BonniePDF.Signing</RootNamespace>
    <AssemblyName>BonniePDF.Signing</AssemblyName>
    <Description>Sign BonniePDF-generated PDFs in .NET with visible or invisible CMS digital signatures, PAdES baseline profiles from B-B through B-LTA, and RFC 3161 timestamps. Supports RSA and ECDSA with PEM or PKCS#12 credentials. Signing is included with every paid BonniePDF licence and is free for non-production evaluation.</Description>
    <Version>2026.11.23</Version>
    <Authors>CodeFocus Limited</Authors>
    <Copyright>Copyright © 2026 CodeFocus Limited</Copyright>
    <!-- Part of the Software under the BonniePDF Commercial License Agreement 1.0,
         shipped with the Signing Package Notice 1.0 for evaluation users. -->
    <PackageLicenseFile>LICENSE</PackageLicenseFile>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>icon.png</PackageIcon>
    <PackageReleaseNotes>https://www.bonniepdf.dev/docs/dotnet/whats-new</PackageReleaseNotes>
    <RepositoryUrl>https://github.com/bonniepdf/BonniePDF-Signing</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>pdf;pdf-signing;digital-signature;visible-signature;cms;pkcs7;pades;rfc3161;timestamp;long-term-validation;pkcs12;rsa;ecdsa;csharp;dotnet;bonniepdf</PackageTags>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591;CS1573;CS8632;MA0002;MA0004;MA0006;MA0009;MA0011;MA0015;MA0046;MA0048;MA0051;MA0074;MA0089;MA0140;CA1854;CA1859</NoWarn>
    <GeneratePackageOnBuild>True</GeneratePackageOnBuild>
    <Title>BonniePDF.Signing</Title>
    <PackageProjectUrl>https://www.bonniepdf.dev/features/dotnet/signing</PackageProjectUrl>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="BonniePDF.Signing.Tests" />
    <!-- The sample generator compiles the shared test PKI, which builds DER
         with the internal Asn1 helpers. -->
    <InternalsVisibleTo Include="BonniePDF.Signing.SampleGen" />
  </ItemGroup>

  <ItemGroup>
    <!-- CMS (SignedCms/CmsSigner/Pkcs9SigningTime) and RFC 3161
         (Rfc3161TimestampRequest/Token) live in this Microsoft BCL assembly,
         which is not in the default compile reference set on either target. Not a
         third-party dependency. Each target takes the servicing line that matches its
         runtime, so net8.0 consumers are not pulled onto 10.x BCL packages. -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="8.0.2" Condition="'$(TargetFramework)' == 'net8.0'" />
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.13" Condition="'$(TargetFramework)' == 'net10.0'" />
  </ItemGroup>

  <ItemGroup>
    <None Include="LICENSE" Pack="True" PackagePath="\" Condition="Exists('LICENSE')" />
    <None Include="COMMERCIAL-LICENSE.txt" Pack="True" PackagePath="\" Condition="Exists('COMMERCIAL-LICENSE.txt')" />
    <None Include="README.md" Pack="True" PackagePath="\" Condition="Exists('README.md')" />
    <None Include="LICENSING.md" Pack="True" PackagePath="\" Condition="Exists('LICENSING.md')" />
    <None Include="icon.png" Pack="True" PackagePath="\" />
  </ItemGroup>

  <!--
    No third-party package references. CMS (System.Security.Cryptography.Pkcs),
    RFC 3161 (System.Security.Cryptography), and DER (System.Formats.Asn1) are
    all part of the .NET platform (8 and 10). The signer operates on byte[] output, so it
    has no project reference to BonniePDF core either - it is fully decoupled.
  -->

</Project>
