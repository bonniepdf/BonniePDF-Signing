<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
    <RootNamespace>BonniePDF.Signing.SampleGen</RootNamespace>
    <AssemblyName>BonniePDF.Signing.SampleGen</AssemblyName>
    <IsPackable>false</IsPackable>
    <NoWarn>$(NoWarn);CS1591;CS1573;CS8632;MA0002;MA0004;MA0006;MA0009;MA0011;MA0015;MA0046;MA0048;MA0051;MA0074;MA0089;MA0140;CA1854;CA1859;CA1861</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- The throwaway PKI is shared with the test project, so the validation
         gate signs with exactly the PKI the tests assert against. -->
    <Compile Include="..\shared\TestPki.cs" Link="TestPki.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\BonniePDF-NET\BonniePDF\BonniePDF.csproj" />
    <ProjectReference Include="..\BonniePDF.Signing\BonniePDF.Signing.csproj" />
  </ItemGroup>

</Project>
