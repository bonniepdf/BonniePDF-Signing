{
  // Typechecks a consumer of the built package the way an application on
  // `moduleResolution: "nodenext"` sees it. The package refers to itself by
  // name, so this resolves through `exports` to dist/, as an installed copy
  // would. Run after `pnpm build`; `prepublishOnly` runs it before a publish.
  "compilerOptions": {
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "target": "es2022",
    "lib": ["es2022", "dom", "dom.iterable"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": false,
    "types": ["node"]
  },
  "files": ["esm.ts"]
}
