{
  "name": "@bonniepdf/signing",
  "version": "2026.7.2",
  "description": "Digital signatures for BonniePDF. Embeds an invisible PKCS#7 / CMS signature (RSA or ECDSA) into a BonniePDF-generated PDF via a minimal incremental update. Zero runtime dependencies - all crypto runs on the Web Crypto API.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "LICENSE",
    "README.md",
    "LICENSING.md"
  ],
  "sideEffects": false,
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "prepack": "pnpm run build",
    "prepublishOnly": "node scripts/check-license-key.mjs",
    "clean": "node --input-type=module -e \"import { rmSync } from 'fs'; rmSync('dist', { recursive: true, force: true });\"",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [
    "pdf",
    "pdf-signing",
    "digital-signature",
    "pkcs7",
    "cms",
    "rsa",
    "ecdsa",
    "bonniepdf",
    "zero-dependency"
  ],
  "license": "SEE LICENSE IN LICENSE",
  "author": "BonniePDF",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bonniepdf/BonniePDF-Signing.git",
    "directory": "typescript/signing"
  },
  "homepage": "https://bonniepdf.dev",
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@bonniepdf/core": "workspace:*",
    "@types/node": "^25.9.3",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
