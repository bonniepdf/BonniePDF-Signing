{
  "name": "@bonniepdf/signing",
  "version": "2026.11.21",
  "description": "Sign BonniePDF-generated PDFs in TypeScript and JavaScript with visible or invisible CMS digital signatures, PAdES baseline profiles from B-B through B-LTA, and RFC 3161 timestamps. Use RSA or ECDSA with PEM or PKCS#12 credentials. Uses the Web Crypto API and has zero runtime dependencies.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "LICENSE",
    "COMMERCIAL-LICENSE.txt",
    "README.md",
    "LICENSING.md"
  ],
  "sideEffects": false,
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsup && tsc --noEmit false --emitDeclarationOnly --declaration --declarationMap --outDir dist && node scripts/fix-dts-extensions.mjs dist && node scripts/emit-cjs-declarations.mjs dist",
    "check:consumer-types": "tsc -p scripts/consumer-types/tsconfig.json",
    "prepublishOnly": "pnpm run check:consumer-types",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "prepack": "pnpm run build",
    "clean": "node --input-type=module -e \"import { rmSync } from 'fs'; rmSync('dist', { recursive: true, force: true });\"",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [
    "pdf",
    "pdf-signing",
    "digital-signature",
    "visible-signature",
    "pkcs7",
    "cms",
    "pades",
    "rfc3161",
    "timestamp",
    "long-term-validation",
    "pkcs12",
    "rsa",
    "ecdsa",
    "typescript",
    "javascript",
    "web-crypto",
    "bonniepdf",
    "zero-dependency"
  ],
  "license": "SEE LICENSE IN LICENSE",
  "author": "CodeFocus Limited",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bonniepdf/BonniePDF-Signing.git",
    "directory": "typescript/signing"
  },
  "bugs": {
    "url": "https://github.com/bonniepdf/BonniePDF-Signing/issues"
  },
  "homepage": "https://www.bonniepdf.dev/features/typescript/signing",
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@bonniepdf/core": "workspace:*",
    "@types/node": "26.2.0",
    "tsup": "^8.5.1",
    "typescript": "7.0.2",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
