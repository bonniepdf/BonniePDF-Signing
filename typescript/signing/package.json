{
  "name": "@bonniepdf/signing",
  "version": "2026.10.22",
  "description": "Digital signatures for BonniePDF. Embeds invisible or visible CMS signatures (RSA or ECDSA), the PAdES baseline levels B-B through B-LTA and RFC 3161 timestamps into a BonniePDF-generated PDF via minimal incremental updates. Zero runtime dependencies - all crypto runs on the Web Crypto API.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "LICENSE",
    "COMMERCIAL-LICENSE.txt",
    "README.md",
    "LICENSING.md"
  ],
  "sideEffects": false,
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsup && tsc --noEmit false --emitDeclarationOnly --declaration --declarationMap --outDir dist",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "prepack": "pnpm run build",
    "clean": "node --input-type=module -e \"import { rmSync } from 'fs'; rmSync('dist', { recursive: true, force: true });\"",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [
    "pdf",
    "pdf-signing",
    "digital-signature",
    "pkcs7",
    "cms",
    "rsa",
    "ecdsa",
    "bonniepdf",
    "zero-dependency"
  ],
  "license": "SEE LICENSE IN LICENSE",
  "author": "CodeFocus Limited",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bonniepdf/BonniePDF-Signing.git",
    "directory": "typescript/signing"
  },
  "homepage": "https://bonniepdf.dev",
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@bonniepdf/core": "workspace:*",
    "@types/node": "26.2.0",
    "tsup": "^8.5.1",
    "typescript": "7.0.2",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
