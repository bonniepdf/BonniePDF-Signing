node_modules/
dist/
coverage/
.turbo/

bin/
obj/
nupkgs/
signed-samples/

# The DSS validation gate resolves its jars and compiles its helper in place.
# Unanchored on purpose: the gate is vendored under both dotnet/ and
# typescript/signing/, so a root-anchored pattern would match neither.
**/tools/dss/lib/
**/tools/dss/*.class
**/dss-summary.md

*.user
*.suo
*.nupkg
vendor-license-key.pem
bonniepdf.license

# Environment variables - never commit real values (.env.example is fine)
.env
.env.local
.env.*.local
.env.development
.env.production
!.env.example
